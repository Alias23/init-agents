generate_agents_md() {
  local path="AGENTS.md"
  local content

  if [[ -f "$path" ]]; then
    if $APPEND_AGENTS; then
      if grep -qF "$MARKER_START" "$path"; then
        if $DRY_RUN; then
          info "  [dry-run] omitiría $path (bloque SDD ya presente)"
        else
          skipped "$path (bloque SDD ya presente)"
          SKIPPED=$((SKIPPED + 1))
        fi
      elif $DRY_RUN; then
        info "  [dry-run] anexaría el bloque SDD a $path"
      else
        [[ -s "$path" ]] && printf '\n' >>"$path"
        render_agents_block >>"$path"
        printf '\n' >>"$path"
        ok "anexado bloque SDD a $path"
        APPENDED=$((APPENDED + 1))
      fi
    elif $FORCE; then
      if $DRY_RUN; then
        info "  [dry-run] sobrescribiría $path"
      else
        content="$(render_agents_full)"
        backup_file "$path"
        printf '%s\n' "$content" >"$path"
        ok "sobrescrito $path"
        OVERWRITTEN=$((OVERWRITTEN + 1))
      fi
    else
      skipped "$path (ya existe; usa --append-agents o --force)"
      SKIPPED=$((SKIPPED + 1))
    fi
  else
    content="$(render_agents_full)"
    if $DRY_RUN; then
      info "  [dry-run] crearía $path"
    else
      printf '%s\n' "$content" >"$path"
      ok "creado $path"
      CREATED=$((CREATED + 1))
    fi
  fi
}

