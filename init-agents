#!/usr/bin/env bash
# init-agents — Genera la estructura Spec-Driven Development (SDD) en el proyecto actual.
# Requiere Bash 4+.

set -euo pipefail

VERSION="1.0.0"

# ---------------------------------------------------------------------------
# Estado y valores por defecto
# ---------------------------------------------------------------------------
PROJECT_NAME=""
PROJECT_DESCRIPTION=""
STACK=""
TEST_COMMAND=""
TEST_COMMAND_YAML=""
DATA_STORE=""
UI_CHECK=""
CODE_LANGUAGE=""
DOC_LANGUAGE=""
TODAY="$(date +%F)"

PROJECT_NAME_ESC=""
PROJECT_DESCRIPTION_ESC=""
STACK_ESC=""
TEST_COMMAND_ESC=""
TEST_COMMAND_YAML_ESC=""
DATA_STORE_ESC=""
UI_CHECK_ESC=""
CODE_LANGUAGE_ESC=""
DOC_LANGUAGE_ESC=""
GUIDE_LINK=""
GUIDE_LINK_ESC=""
GUIDE_REFERENCE=""
GUIDE_REFERENCE_ESC=""

FORCE=false
APPEND_AGENTS=false
DRY_RUN=false
ASSUME_YES=false
LIST_ONLY=false
NO_GUIDE=false

CREATED=0
SKIPPED=0
OVERWRITTEN=0
APPENDED=0
TOTAL_FILES=0

MARKER_START="<!-- init-agents:sdd:start -->"

# ---------------------------------------------------------------------------
# Salida
# ---------------------------------------------------------------------------
info() { printf '%s\n' "$*"; }
ok() { printf '  [ok] %s\n' "$*"; }
skipped() { printf '  [skip] %s\n' "$*"; }
warn() { printf '  [warn] %s\n' "$*" >&2; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
init-agents $VERSION — Genera la estructura Spec-Driven Development en el proyecto actual.

USO:
  init-agents [opciones]

El script se ejecuta en el directorio actual. No lo ejecutes en / ni en \$HOME.

OPCIONES:
  --name TEXTO             Nombre del proyecto.
  --description TEXTO      Descripción breve del proyecto.
  --stack TEXTO            Stack principal.
  --test-command COMANDO   Comando de tests.
  --data-store TEXTO       Persistencia de datos.
  --ui-check TEXTO         Cómo verificar la interfaz.
  --code-language IDIOMA   Idioma del código.
  --doc-language IDIOMA    Idioma de documentación e interfaz.
  -y, --yes                Usa los valores detectados sin preguntar.
  -f, --force              Sobrescribe archivos existentes con backup.
  --append-agents          Añade el bloque SDD a un AGENTS.md existente.
  --no-guide               No genera docs/sdd.md (la guía del flujo).
  -n, --dry-run            Muestra lo que haría sin escribir.
  --list                   Lista los archivos que generaría.
  -h, --help               Muestra esta ayuda.
  -v, --version            Muestra la versión.

EJEMPLOS:
  cd mi-proyecto && init-agents
  init-agents --yes
  init-agents --append-agents
  init-agents --force --test-command "npm test"
EOF
}

# ---------------------------------------------------------------------------
# Utilidades
# ---------------------------------------------------------------------------
backup_file() {
  local path="$1"
  local ts backup n=1
  ts="$(date +%Y%m%d%H%M%S)"
  backup="${path}.bak.${ts}"
  while [[ -e "$backup" ]]; do
    backup="${path}.bak.${ts}.${n}"
    n=$((n + 1))
  done
  cp -p "$path" "$backup" || die "No se pudo crear el backup de $path"
  warn "backup: $backup"
}

render_content() {
  local content="$1"
  content="${content//'{{PROJECT_NAME}}'/$PROJECT_NAME_ESC}"
  content="${content//'{{PROJECT_DESCRIPTION}}'/$PROJECT_DESCRIPTION_ESC}"
  content="${content//'{{STACK}}'/$STACK_ESC}"
  content="${content//'{{TEST_COMMAND_YAML}}'/$TEST_COMMAND_YAML_ESC}"
  content="${content//'{{TEST_COMMAND}}'/$TEST_COMMAND_ESC}"
  content="${content//'{{DATA_STORE}}'/$DATA_STORE_ESC}"
  content="${content//'{{UI_CHECK}}'/$UI_CHECK_ESC}"
  content="${content//'{{CODE_LANGUAGE}}'/$CODE_LANGUAGE_ESC}"
  content="${content//'{{DOC_LANGUAGE}}'/$DOC_LANGUAGE_ESC}"
  content="${content//'{{GUIDE_LINK}}'/$GUIDE_LINK_ESC}"
  content="${content//'{{GUIDE_REFERENCE}}'/$GUIDE_REFERENCE_ESC}"
  content="${content//'{{DATE}}'/$TODAY}"
  printf '%s' "$content"
}

write_file() {
  local path="$1"
  local content="$2"

  if $DRY_RUN; then
    if [[ -e "$path" ]]; then
      if $FORCE; then
        info "  [dry-run] sobrescribiría $path"
      else
        info "  [dry-run] omitiría $path (ya existe)"
      fi
    else
      info "  [dry-run] crearía $path"
    fi
    return 0
  fi

  if [[ -e "$path" ]]; then
    if $FORCE; then
      backup_file "$path"
      mkdir -p "$(dirname "$path")"
      printf '%s\n' "$content" >"$path"
      ok "sobrescrito $path"
      OVERWRITTEN=$((OVERWRITTEN + 1))
    else
      skipped "$path (ya existe)"
      SKIPPED=$((SKIPPED + 1))
    fi
  else
    mkdir -p "$(dirname "$path")"
    printf '%s\n' "$content" >"$path"
    ok "creado $path"
    CREATED=$((CREATED + 1))
  fi
}

render_file() {
  local path="$1"
  local content
  content="$(cat)"
  content="$(render_content "$content")"
  write_file "$path" "$content"
}

# ---------------------------------------------------------------------------
# Detección de valores
# ---------------------------------------------------------------------------
detect_project_name() {
  basename "$PWD"
}

detect_description() {
  printf '%s\n' "Proyecto gestionado con Spec-Driven Development (SDD)."
}

detect_stack() {
  if [[ -f package.json ]]; then
    if grep -q '"next"' package.json 2>/dev/null; then
      printf '%s\n' "Next.js"
    elif grep -q '"react"' package.json 2>/dev/null; then
      printf '%s\n' "React"
    elif grep -q '"vue"' package.json 2>/dev/null; then
      printf '%s\n' "Vue"
    elif grep -q '"svelte"' package.json 2>/dev/null; then
      printf '%s\n' "Svelte"
    else
      printf '%s\n' "Node.js/JavaScript"
    fi
  elif [[ -f pyproject.toml || -f requirements.txt || -f setup.py ]]; then
    printf '%s\n' "Python"
  elif [[ -f go.mod ]]; then
    printf '%s\n' "Go"
  elif [[ -f Cargo.toml ]]; then
    printf '%s\n' "Rust"
  elif [[ -f index.html ]]; then
    printf '%s\n' "HTML/CSS/JS"
  else
    printf '%s\n' "el stack del proyecto"
  fi
}

detect_test_command() {
  if [[ -f package.json ]]; then
    if grep -q '"test"[[:space:]]*:' package.json 2>/dev/null; then
      if [[ -f pnpm-lock.yaml ]]; then
        printf '%s\n' "pnpm test"
      elif [[ -f yarn.lock ]]; then
        printf '%s\n' "yarn test"
      elif [[ -f bun.lockb || -f bun.lock ]]; then
        printf '%s\n' "bun test"
      else
        printf '%s\n' "npm test"
      fi
    else
      printf '%s\n' "no definido"
    fi
  elif [[ -f pyproject.toml || -f pytest.ini || -f tox.ini ]]; then
    printf '%s\n' "pytest"
  elif [[ -f go.mod ]]; then
    printf '%s\n' "go test ./..."
  elif [[ -f Cargo.toml ]]; then
    printf '%s\n' "cargo test"
  else
    printf '%s\n' "no definido"
  fi
}

grep_code() {
  local pattern="$1"
  grep -Rqs \
    --exclude-dir=.git \
    --exclude-dir=node_modules \
    --exclude-dir=.opencode \
    --exclude-dir=.agents \
    --include='*.js' \
    --include='*.ts' \
    --include='*.jsx' \
    --include='*.tsx' \
    --include='*.html' \
    --include='*.py' \
    --include='*.go' \
    --include='*.rs' \
    -- "$pattern" . 2>/dev/null
}

detect_data_store() {
  if grep_code 'localStorage'; then
    printf '%s\n' "localStorage"
  elif grep_code 'sqlite'; then
    printf '%s\n' "SQLite"
  elif grep_code 'postgres'; then
    printf '%s\n' "PostgreSQL"
  else
    printf '%s\n' "la persistencia del proyecto"
  fi
}

detect_ui_check() {
  if [[ -f index.html ]]; then
    printf '%s\n' "manual en el navegador"
  else
    printf '%s\n' "no aplica"
  fi
}

# ---------------------------------------------------------------------------
# Preguntas interactivas
# ---------------------------------------------------------------------------
ask_var() {
  local __var="$1"
  local label="$2"
  local default="$3"
  local value=""

  if $ASSUME_YES || [[ ! -t 0 ]]; then
    printf -v "$__var" '%s' "$default"
    return 0
  fi

  IFS= read -r -p "$label [$default]: " value || true
  printf -v "$__var" '%s' "${value:-$default}"
}

validate_value() {
  local name="$1"
  local value="$2"
  if [[ "$value" == *"{{"* || "$value" == *"}}"* ]]; then
    die "$name no puede contener '{{' o '}}'."
  fi
  if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    die "$name no puede contener saltos de línea."
  fi
}

escape_replacement() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//&/\\&}"
  printf '%s' "$value"
}

