# ---------------------------------------------------------------------------
# Argumentos
# ---------------------------------------------------------------------------
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        [[ $# -ge 2 ]] || die "Falta el valor de --name."
        PROJECT_NAME="$2"
        shift 2
        ;;
      --description)
        [[ $# -ge 2 ]] || die "Falta el valor de --description."
        PROJECT_DESCRIPTION="$2"
        shift 2
        ;;
      --stack)
        [[ $# -ge 2 ]] || die "Falta el valor de --stack."
        STACK="$2"
        shift 2
        ;;
      --test-command)
        [[ $# -ge 2 ]] || die "Falta el valor de --test-command."
        TEST_COMMAND="$2"
        shift 2
        ;;
      --data-store)
        [[ $# -ge 2 ]] || die "Falta el valor de --data-store."
        DATA_STORE="$2"
        shift 2
        ;;
      --ui-check)
        [[ $# -ge 2 ]] || die "Falta el valor de --ui-check."
        UI_CHECK="$2"
        shift 2
        ;;
      --code-language)
        [[ $# -ge 2 ]] || die "Falta el valor de --code-language."
        CODE_LANGUAGE="$2"
        shift 2
        ;;
      --doc-language)
        [[ $# -ge 2 ]] || die "Falta el valor de --doc-language."
        DOC_LANGUAGE="$2"
        shift 2
        ;;
      -y | --yes)
        ASSUME_YES=true
        shift
        ;;
      -f | --force)
        FORCE=true
        shift
        ;;
      --append-agents)
        APPEND_AGENTS=true
        shift
        ;;
      --no-guide)
        NO_GUIDE=true
        shift
        ;;
      -n | --dry-run)
        DRY_RUN=true
        shift
        ;;
      --list)
        LIST_ONLY=true
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -v | --version)
        printf '%s\n' "$VERSION"
        exit 0
        ;;
      --)
        shift
        break
        ;;
      -*)
        die "Opción desconocida: $1. Usa --help."
        ;;
      *)
        die "Argumento no esperado: $1. El script se ejecuta en el directorio actual."
        ;;
    esac
  done

  if $FORCE && $APPEND_AGENTS; then
    die "--force y --append-agents son mutuamente excluyentes."
  fi
}

# ---------------------------------------------------------------------------
# Principal
# ---------------------------------------------------------------------------
main() {
  if ((BASH_VERSINFO[0] < 4)); then
    die "Se requiere Bash 4 o superior."
  fi

  local cwd home_real
  cwd="$(pwd -P)"
  home_real="$(cd "${HOME:-/nonexistent}" 2>/dev/null && pwd -P || printf '%s' "${HOME:-/nonexistent}")"
  [[ "$cwd" == "/" ]] && die "No se puede ejecutar en /. Entra en la carpeta del proyecto."
  [[ "$cwd" == "$home_real" ]] && die "No se puede ejecutar en \$HOME. Entra en la carpeta del proyecto."
  [[ -w "$cwd" ]] || die "El directorio actual no es escribible."

  TOTAL_FILES="$(list_files | wc -l | tr -d ' ')"

  if $LIST_ONLY; then
    list_files
    exit 0
  fi

  # Valores detectados
  PROJECT_NAME="${PROJECT_NAME:-$(detect_project_name)}"
  PROJECT_DESCRIPTION="${PROJECT_DESCRIPTION:-$(detect_description)}"
  STACK="${STACK:-$(detect_stack)}"
  TEST_COMMAND="${TEST_COMMAND:-$(detect_test_command)}"
  DATA_STORE="${DATA_STORE:-$(detect_data_store)}"
  UI_CHECK="${UI_CHECK:-$(detect_ui_check)}"
  CODE_LANGUAGE="${CODE_LANGUAGE:-inglés}"
  DOC_LANGUAGE="${DOC_LANGUAGE:-español}"

  if ! $ASSUME_YES && [[ -t 0 ]]; then
    info "Configuración del proyecto (Enter para aceptar el valor entre corchetes):"
    ask_var PROJECT_NAME "  Nombre del proyecto" "$PROJECT_NAME"
    ask_var PROJECT_DESCRIPTION "  Descripción breve" "$PROJECT_DESCRIPTION"
    ask_var STACK "  Stack principal" "$STACK"
    ask_var TEST_COMMAND "  Comando de tests" "$TEST_COMMAND"
    ask_var DATA_STORE "  Persistencia de datos" "$DATA_STORE"
    ask_var UI_CHECK "  Verificación visual" "$UI_CHECK"
    ask_var CODE_LANGUAGE "  Idioma del código" "$CODE_LANGUAGE"
    ask_var DOC_LANGUAGE "  Idioma de documentación e interfaz" "$DOC_LANGUAGE"
    info ""
  fi

  [[ -z "$PROJECT_NAME" ]] && PROJECT_NAME="$(detect_project_name)"
  [[ -z "$PROJECT_DESCRIPTION" ]] && PROJECT_DESCRIPTION="$(detect_description)"
  [[ -z "$STACK" ]] && STACK="$(detect_stack)"
  [[ -z "$TEST_COMMAND" ]] && TEST_COMMAND="no definido"
  [[ -z "$DATA_STORE" ]] && DATA_STORE="la persistencia del proyecto"
  [[ -z "$UI_CHECK" ]] && UI_CHECK="no aplica"
  [[ -z "$CODE_LANGUAGE" ]] && CODE_LANGUAGE="inglés"
  [[ -z "$DOC_LANGUAGE" ]] && DOC_LANGUAGE="español"

  validate_value "Nombre del proyecto" "$PROJECT_NAME"
  validate_value "Descripción" "$PROJECT_DESCRIPTION"
  validate_value "Stack" "$STACK"
  validate_value "Comando de tests" "$TEST_COMMAND"
  validate_value "Persistencia" "$DATA_STORE"
  validate_value "Verificación visual" "$UI_CHECK"
  validate_value "Idioma del código" "$CODE_LANGUAGE"
  validate_value "Idioma de documentación" "$DOC_LANGUAGE"

  TEST_COMMAND_YAML="${TEST_COMMAND//\'/\'\'}"
  if $NO_GUIDE; then
    GUIDE_LINK=""
    # shellcheck disable=SC2016 # Las comillas invertidas son Markdown, no sustitución.
    GUIDE_REFERENCE='la skill `sdd`'
  else
    # shellcheck disable=SC2016 # Las comillas invertidas son Markdown, no sustitución.
    GUIDE_LINK='- [`sdd.md`](sdd.md): guía del flujo Spec-Driven Development, comandos y ejemplos.'
    # shellcheck disable=SC2016 # Las comillas invertidas son Markdown, no sustitución.
    GUIDE_REFERENCE='`docs/sdd.md` y la skill `sdd`'
  fi
  PROJECT_NAME_ESC="$(escape_replacement "$PROJECT_NAME")"
  PROJECT_DESCRIPTION_ESC="$(escape_replacement "$PROJECT_DESCRIPTION")"
  STACK_ESC="$(escape_replacement "$STACK")"
  TEST_COMMAND_ESC="$(escape_replacement "$TEST_COMMAND")"
  TEST_COMMAND_YAML_ESC="$(escape_replacement "$TEST_COMMAND_YAML")"
  DATA_STORE_ESC="$(escape_replacement "$DATA_STORE")"
  UI_CHECK_ESC="$(escape_replacement "$UI_CHECK")"
  CODE_LANGUAGE_ESC="$(escape_replacement "$CODE_LANGUAGE")"
  DOC_LANGUAGE_ESC="$(escape_replacement "$DOC_LANGUAGE")"
  GUIDE_LINK_ESC="$(escape_replacement "$GUIDE_LINK")"
  GUIDE_REFERENCE_ESC="$(escape_replacement "$GUIDE_REFERENCE")"

  info "Resumen:"
  info "  Proyecto:        $PROJECT_NAME"
  info "  Descripción:     $PROJECT_DESCRIPTION"
  info "  Stack:           $STACK"
  info "  Tests:           $TEST_COMMAND"
  info "  Persistencia:    $DATA_STORE"
  info "  Verificación:    $UI_CHECK"
  info "  Código:          $CODE_LANGUAGE"
  info "  Documentación:   $DOC_LANGUAGE"
  info ""

  if ! $ASSUME_YES && [[ -t 0 ]]; then
    local answer
    local verb="Generar"
    $DRY_RUN && verb="Simular"
    read -r -p "¿$verb $TOTAL_FILES archivos? [S/n]: " answer || true
    case "$answer" in
      n | N | no | NO | No) info "Cancelado."; exit 0 ;;
    esac
    info ""
  fi

  info "Generando estructura SDD en: $PWD"
  info ""

  local path
  while IFS= read -r path; do
    generate_file "$path"
  done < <(list_files)

  info ""
  info "Resumen:"
  info "  Archivos planificados: $TOTAL_FILES"
  info "  Creados:               $CREATED"
  info "  Omitidos:              $SKIPPED"
  info "  Sobrescritos:          $OVERWRITTEN"
  info "  Anexados:              $APPENDED"

  if $DRY_RUN; then
    info ""
    info "Simulación completada: no se ha escrito nada."
    exit 0
  fi

  local unresolved
  unresolved="$(grep -RIn --include='*.md' -E '\{\{[A-Z_]+\}\}' AGENTS.md MEMORY.md docs specs tests .agents .opencode 2>/dev/null || true)"
  if [[ -n "$unresolved" ]]; then
    warn "Placeholders sin sustituir:"
    printf '%s\n' "$unresolved" >&2
  fi

  info ""
  info "Siguiente:"
  info "  1. Revisa docs/constitution.md y AGENTS.md."
  info "  2. Ejecuta /sdd-spec 001-mi-idea <descripción> en OpenCode."
  info "  3. Usa /sdd-status 001-mi-idea para ver la fase actual."

  if [[ "$TEST_COMMAND" == "no definido" ]]; then
    warn "No se ha definido un comando de tests. Edita AGENTS.md y los agentes cuando lo tengas."
  fi
}

parse_args "$@"
main
